// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["mongodb"]
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model surahs {
  number                 Int    @id @map("_id") @db.Int
  name                   String
  englishName            String
  englishNameTranslation String
  numberOfAyahs          Int
  revelationType         String
}

model ayahs {
  number        Int         @id @map("_id") @db.Int
  text          String
  numberInSurah Int         @unique
  juz           Int
  manzil        Int
  page          Int
  ruku          Int
  hizbQuarter   Int
  surahNumber   Int
  word_data     word_data[]
  wbw           wbw?
  en_ayahs      en_ayahs?
  bn_ayahs      bn_ayahs?
}

model word_data {
  word_id              Int     @id @map("_id") @db.Int
  word_surah           Int?
  word_ayah            Int
  word_page            Int?
  word_number_in_quran Int?
  word_number_in_surah Int?
  word_number_in_ayah  Int?
  word_type            String?
  word_arabic          String?
  word_transliteration String?
  word_translation     String?

  ayahs ayahs @relation(fields: [word_ayah], references: [numberInSurah])

  @@index([word_transliteration], map: "ARABIC")
  @@index([word_ayah, word_number_in_surah], map: "AYAH")
  @@index([word_id, word_surah], map: "ID")
  @@index([word_surah, word_ayah], map: "SURAH")
  @@index([word_id, word_surah, word_ayah, word_number_in_quran, word_number_in_surah, word_number_in_ayah, word_type], map: "word_id")
  @@index([word_number_in_quran], map: "word_number_in_quran")
}

model en_ayahs {
  number Int    @id @map("_id") @db.Int
  text   String
  ayahs  ayahs  @relation(fields: [number], references: [number])
}

model bn_ayahs {
  number Int    @id @map("_id") @db.Int
  text   String 
  ayahs  ayahs  @relation(fields: [number], references: [number])
}

model wbw {
  number       Int    @id @map("_id") @db.Int
  ayah_number  Int
  surah_number Int
  ayah_wbw     String
  ayahs        ayahs  @relation(fields: [number], references: [number])
}
